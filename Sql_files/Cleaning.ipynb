    "cursor.execute(\"DROP TABLE IF EXISTS Order_staging\")\n",
    "conn.commit()\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "CREATE TABLE Order_staging AS\n",
    "SELECT * \n",
    "FROM Orders\n",
    "\"\"\")\n",
    "conn.commit()\n",
    "print(\"Order_staging table created\")\n",
    "print()\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "DELETE FROM Order_staging \n",
    "WHERE rowid NOT IN(\n",
    "    SELECT MIN(rowid) \n",
    "    FROM Orders \n",
    "    GROUP BY OrderID, CustomerName, Email, Phone, City, OrderDate, Amount,Status)\n",
    "\"\"\")\n",
    "\n",
    "conn.commit()\n",
    "print(\"Duplicate removed\")\n",
    "print()\n",
    "    \n",
    "cursor.execute(\"\"\"\n",
    "UPDATE order_staging\n",
    "SET \n",
    "    CustomerName = TRIM(CustomerName),\n",
    "    Email = TRIM(Email),\n",
    "    Phone = TRIM(Phone),\n",
    "    City = TRIM(City),\n",
    "    OrderDate = TRIM(OrderDate),\n",
    "    Status = TRIM(Status),\n",
    "    Amount = TRIM(Amount)\n",
    "\"\"\")\n",
    "\n",
    "conn.commit()\n",
    "print(\"Spaces removed\")\n",
    "print()\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "UPDATE Order_staging\n",
    "SET CustomerName =\n",
    "    UPPER(SUBSTR(CustomerName, 1,1)) ||\n",
    "    LOWER(SUBSTR(CustomerName, 2,INSTR(CustomerName,' ')-2)) ||\n",
    "            ' ' ||\n",
    "            UPPER(SUBSTR(CustomerName,INSTR(CustomerName,' ')+1,1))||\n",
    "            LOWER(SUBSTR(CustomerName,INSTR(CustomerName,' ')+2))\n",
    "WHERE CustomerName IS NOT NULL AND INSTR(CustomerName,' ') > 0\n",
    "\"\"\")\n",
    "conn.commit()\n",
    "print(\"Name format corrected\")\n",
    "print()\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "UPDATE Order_staging\n",
    "SET City = UPPER(SUBSTR(City, 1, 1)) || LOWER(SUBSTR(City,2))\n",
    "WHERE City IS NOT NULL\n",
    "\"\"\")\n",
    "\n",
    "conn.commit()\n",
    "print(\"City format corrected\")\n",
    "print()\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "UPDATE Order_staging\n",
    "SET Status = UPPER(SUBSTR(Status, 1, 1)) || LOWER(SUBSTR(Status,2))\n",
    "WHERE City IS NOT NULL\n",
    "\"\"\")\n",
    "\n",
    "conn.commit()\n",
    "print(\"Status format corrected\")\n",
    "print()\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "UPDATE Order_staging\n",
    "SET Email = TRIM(LOWER(REPLACE(Email, '.','')))\n",
    "WHERE Email IS NOT NULL\n",
    "\"\"\")\n",
    "\n",
    "conn.commit()\n",
    "print(\"Email Id is trimmed\")\n",
    "print()\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "UPDATE order_staging\n",
    "SET CustomerName = 'Unknown',\n",
    "     Email = 'Unknown',\n",
    "     Phone = 'Unknown',\n",
    "     City = 'Unknown'\n",
    "WHERE CustomerName IS NULL OR Email IS NULL OR Phone IS NULL OR City IS NULL\n",
    "\"\"\")\n",
    "\n",
    "conn.commit()\n",
    "print(\"Null values updated\")\n",
    "print()\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "UPDATE Order_staging\n",
    "SET OrderDate =\n",
    "    CASE WHEN SUBSTR(OrderDate,5,1) = '/' THEN\n",
    "              SUBSTR(OrderDate,1,4) || '-' ||\n",
    "              SUBSTR(OrderDate,9,2) || '-' ||\n",
    "              SUBSTR(OrderDate, 6,2)\n",
    "         WHEN (SUBSTR(OrderDate,3,1) = '/' OR SUBSTR(OrderDate,3,1) = '-') AND CAST (SUBSTR(OrderDate, 1,2) AS INTEGER) > 12 THEN\n",
    "              SUBSTR(OrderDate,7,4) || '-' ||\n",
    "              SUBSTR(OrderDate,4,2) || '-' ||\n",
    "              SUBSTR(OrderDate,1,2)\n",
    "        WHEN (SUBSTR(OrderDate,3,1) = '/' OR SUBSTR(OrderDate,3,1) = '-') AND CAST (SUBSTR(OrderDate, 4,2) AS INTEGER) > 12 THEN\n",
    "             SUBSTR(OrderDate,7,4) || '-' ||\n",
    "             SUBSTR(OrderDate,1,2) || '-' ||\n",
    "             SUBSTR(OrderDate,4,2)\n",
    "        WHEN (SUBSTR(OrderDate,3,1) = '/' OR SUBSTR(OrderDate,3,1) = '-') THEN\n",
    "             SUBSTR(OrderDate,7,4) || '-' ||\n",
    "             SUBSTR(OrderDate,1,2) || '-' ||\n",
    "             SUBSTR(OrderDate,4,2)\n",
    "        ELSE OrderDate\n",
    "    END\n",
    "\"\"\")\n",
    "\n",
    "conn.commit()\n",
    "print(\"Date format Updated successfully\")\n",
    "print()\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "SELECT COUNT(*)\n",
    "FROM pragma_table_info('Order_staging')\n",
    "WHERE name = 'Email_valid'\n",
    "\"\"\")\n",
    "\n",
    "exists = cursor.fetchone()[0]\n",
    "if exists:\n",
    "    print(\"Already exists\")\n",
    "else:\n",
    "    cursor.execute(\"\"\"\n",
    "        ALTER TABLE Order_staging\n",
    "        ADD COLUMN Email_valid\n",
    "        \"\"\")\n",
    "    conn.commit()\n",
    "    print(\"Email_valid _coulumn added\")\n",
    "print()   \n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "UPDATE Order_staging\n",
    "SET Email_Valid = \n",
    "    CASE \n",
    "        WHEN Email = 'Unknown' THEN 0 \n",
    "        ELSE 1\n",
    "    END\n",
    "\"\"\")\n",
    "\n",
    "conn.commit()\n",
    "print(\"Email validity checked\")\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "UPDATE Order_staging\n",
    "SET Phone = REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(PHONE,'(',''),')',''),'+',''),' ',''),'-','')\n",
    "\"\"\")\n",
    "\n",
    "conn.commit()\n",
    "print()\n",
    "print(\"Phone formatting done\")\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "UPDATE Order_staging\n",
    "SET Phone = SUBSTR(Phone,3)\n",
    "WHERE PHONE IS NOT NULL AND LENGTH(Phone) = 12 AND SUBSTR(Phone,1,2) = '91'\n",
    "\"\"\")\n",
    "\n",
    "conn.commit()\n",
    "print()\n",
    "print(\"Phone number updated successfully\")\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "SELECT COUNT(*)\n",
    "FROM pragma_table_info('Order_staging')\n",
    "WHERE name = 'Phone_valid'\n",
    "\"\"\")\n",
    "print()\n",
    "exists = cursor.fetchone()[0]\n",
    "if exists:\n",
    "    print(\"Already exists\")\n",
    "else:\n",
    "    cursor.execute(\"\"\"\n",
    "        ALTER TABLE Order_staging\n",
    "        ADD COLUMN Phone_valid\n",
    "        \"\"\")\n",
    "    conn.commit()\n",
    "    print(\"Phone_valid coulumn added\")\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "UPDATE Order_staging \n",
    "SET Phone_valid = CASE \n",
    "                    WHEN Phone IS NOT NULL AND LENGTH(Phone) = 10 AND PHONE NOT GLOB '*[^0-9]*' THEN 1\n",
    "                    ELSE 0\n",
    "                  END\n",
    "\"\"\")\n",
    "\n",
    "conn.commit()\n",
    "print()\n",
    "print(\"Phone validity checked successfully\")\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "UPDATE Order_staging\n",
    "SET Amount = REPLACE(REPLACE(REPLACE(Amount, '₹', ''),',',''),' ','')\n",
    "WHERE Amount IS NOT NULL\n",
    "\"\"\")\n",
    "\n",
    "conn.commit()\n",
    "print()\n",
    "print(\"Amount formatted perfectly\")\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "SELECT COUNT(*)\n",
    "FROM pragma_table_info('Order_staging')\n",
    "WHERE name = 'Amount_clean'\n",
    "\"\"\")\n",
    "print()\n",
    "exists = cursor.fetchone()[0]\n",
    "if exists:\n",
    "    print(\"Already exists\")\n",
    "else:\n",
    "    cursor.execute(\"\"\"\n",
    "        ALTER TABLE Order_staging\n",
    "        ADD COLUMN Amount_clean\n",
    "        \"\"\")\n",
    "    conn.commit()\n",
    "    print(\"Amount_clean coulumn added\")\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "UPDATE Order_staging\n",
    "SET Amount_clean = CAST(Amount AS REAL)\n",
    "WHERE AMOUNT IS NOT NULL\n",
    "\"\"\")\n",
    "\n",
    "conn.commit()\n",
    "print()\n",
    "print(\"Amount casted to real successfully\")\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "SELECT COUNT(*)\n",
    "FROM pragma_table_info('Order_staging')\n",
    "WHERE name = 'Amount_flag'\n",
    "\"\"\")\n",
    "print()\n",
    "exists = cursor.fetchone()[0]\n",
    "if exists:\n",
    "    print(\"Already exists\")\n",
    "else:\n",
    "    cursor.execute(\"\"\"\n",
    "        ALTER TABLE Order_staging\n",
    "        ADD COLUMN Amount_flag\n",
    "        \"\"\")\n",
    "    conn.commit()\n",
    "    print(\"Amount_flag coulumn added\")\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "UPDATE Order_staging\n",
    "SET AMOUNT_flag = CASE\n",
    "                    WHEN Amount_clean IS NULL THEN \"Missing\"\n",
    "                    WHEN Amount_clean < 0 THEN \"Negative\"\n",
    "                    WHEN Amount_clean > 20000 THEN \"Outlier\"\n",
    "                    ELSE \"OK\"\n",
    "                  END\n",
    "\"\"\")\n",
    "\n",
    "conn.commit()\n",
    "print()\n",
    "print(\"Amount flag completed\")\n",
    "\n",
    "cursor.execute(\"DROP TABLE IF EXISTS order_clean\")\n",
    "conn.commit()\n",
    "cursor.execute(\"\"\"\n",
    "CREATE TABLE order_clean AS \n",
    "SELECT OrderID, CustomerName, Email,\n",
    "       Email_valid,Phone,Phone_valid,\n",
    "       City,OrderDate,Amount_clean AS Amount,\n",
    "       Amount_flag,Status\n",
    "FROM Order_staging\n",
    "\"\"\")\n",
    "\n",
    "conn.commit()\n",
    "print()\n",
    "print(\"Clean table created\")"
   ]
  },
