   "source": [
    "print(\"Status of clean table\")\n",
    "cursor.execute(\"SELECT * FROM order_clean LIMIT 5\")\n",
    "result = cursor.fetchall()\n",
    "for r in result:\n",
    "    print(r)\n",
    "\n",
    "print()\n",
    "print(\"Average order amount by city:\")\n",
    "cursor.execute(\"\"\"\n",
    "SELECT City, \n",
    "       ROUND(AVG(AMOUNT),2) AS Avg_amount\n",
    "FROM order_clean\n",
    "WHERE Amount_flag = 'OK'\n",
    "GROUP BY City\n",
    "ORDER BY Avg_amount DESC\n",
    "\"\"\")\n",
    "result = cursor.fetchall()\n",
    "for r in result:\n",
    "    print(r)\n",
    "\n",
    "print()\n",
    "print(\"Total Sales by city:\")\n",
    "cursor.execute(\"\"\"\n",
    "SELECT City, \n",
    "       ROUND(SUM(AMOUNT),2) AS Total_sales\n",
    "FROM order_clean\n",
    "WHERE Amount_flag = 'OK'\n",
    "GROUP BY City\n",
    "ORDER BY Total_sales DESC\n",
    "\"\"\")\n",
    "result = cursor.fetchall()\n",
    "for r in result:\n",
    "    print(r)\n",
    "\n",
    "print()\n",
    "print(\"Number of orders by city\")\n",
    "cursor.execute(\"\"\"\n",
    "SELECT City,\n",
    "       COUNT(*) AS Total_orders\n",
    "FROM order_clean\n",
    "GROUP BY City\n",
    "ORDER BY Total_orders\n",
    "\"\"\")\n",
    "result = cursor.fetchall()\n",
    "for r in result:\n",
    "    print(r)\n",
    "\n",
    "print()\n",
    "print(\"Completed Orders\")\n",
    "cursor.execute(\"\"\"\n",
    "SELECT COUNT(*) AS completed_orders\n",
    "FROM order_clean\n",
    "WHERE Status = 'Completed'\n",
    "\"\"\")\n",
    "result = cursor.fetchall()\n",
    "for r in result:\n",
    "    print(r)\n",
    "\n",
    "print()\n",
    "print(\"Cancelled Orders by city\")\n",
    "cursor.execute(\"\"\"\n",
    "SELECT city,\n",
    "       COUNT(*) AS Cancelled_orders\n",
    "FROM order_clean\n",
    "WHERE Status = 'Cancelled'\n",
    "GROUP BY City\n",
    "ORDER BY Cancelled_orders DESC\n",
    "\"\"\")\n",
    "result = cursor.fetchall()\n",
    "for r in result:\n",
    "    print(r)\n",
    "\n",
    "print()\n",
    "print(\"Monthly sales analysis\")\n",
    "cursor.execute(\"\"\"\n",
    "SELECT SUBSTR(OrderDate, 1,7) AS Year_month,\n",
    "       COUNT(*) AS Total_orders,\n",
    "       ROUND(SUM(Amount),2) AS Total_sales\n",
    "FROM order_clean\n",
    "WHERE Amount_flag = 'OK' AND OrderDate IS NOT NULL\n",
    "GROUP BY SUBSTR(OrderDate, 1,7)\n",
    "ORDER BY Year_month\n",
    "\"\"\")\n",
    "result = cursor.fetchall()\n",
    "for r in result:\n",
    "    print(r)"
