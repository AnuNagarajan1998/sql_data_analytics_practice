   "source": [
    "import pandas as pd\n",
    "import sqlite3\n",
    "\n",
    "df = pd.read_excel(r\"C:\\Users\\anura\\OneDrive\\Desktop\\anu_fita_course\\SQL\\orders_raw.xlsx\")\n",
    "\n",
    "print(len(df))\n",
    "print()\n",
    "\n",
    "conn = sqlite3.connect(\"Orders_raw.db\")\n",
    "cursor = conn.cursor()\n",
    "\n",
    "print(\"Connetion and database created successfully\")\n",
    "\n",
    "cursor.execute(\"DROP TABLE IF EXISTS Orders\")\n",
    "conn.commit()\n",
    "\n",
    "cursor.execute(\"\"\"\n",
    "    CREATE TABLE Orders(\n",
    "        OrderID INTEGER,\n",
    "        CustomerName TEXT,\n",
    "        Email TEXT,\n",
    "        Phone TEXT,\n",
    "        City TEXT,\n",
    "        OrderDate DATE,\n",
    "        Amount REAL,\n",
    "        Status TEXT)\n",
    "\"\"\")\n",
    "conn.commit()\n",
    "print(\"Table created successfully\")\n",
    "\n",
    "order_data = df[[\"OrderID\",\"CustomerName\",\"Email\",\"Phone\",\"City\",\"OrderDate\",\"Amount\",\"Status\"]].values.tolist()\n",
    "\n",
    "cursor.execute(\"SELECT COUNT(*) FROM Orders\")\n",
    "count = cursor.fetchone()[0]\n",
    "\n",
    "if count == 0:\n",
    "    cursor.executemany(\"\"\"\n",
    "        INSERT INTO Orders (OrderID,CustomerName,Email,Phone,City,OrderDate,Amount,Status)\n",
    "        VALUES (?,?,?,?,?,?,?,?)\"\"\", order_data)\n",
    "    print(\"Table data entered successfully\")\n",
    "else:\n",
    "    print(\"Data already exists\")"
   ]
  },
